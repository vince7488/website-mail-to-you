{
  "require": {
    "php": ">=8.3",
    "ext-ctype": "*",
    "ext-filter": "*",
    "ext-hash": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "phpmailer/phpmailer": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "StaticFormMailer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StaticFormMailer\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src tests",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "phpstan/phpstan": "^2.3"
  }
}
